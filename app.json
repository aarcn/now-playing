{
  "package_id": "io.github.aarcn.nowplaying",
  "edition": "202601",
  "name": "Now Playing",
  "version": "0.4.3",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Talks to Spotify to show what's playing, control playback, browse your library and load album covers, and to LRCLIB for lyrics.",
      "whitelist": [
        "https://accounts.spotify.com",
        "https://api.spotify.com",
        "https://i.scdn.co",
        "https://mosaic.scdn.co",
        "https://image-cdn-ak.spotifycdn.com",
        "https://image-cdn-fa.spotifycdn.com",
        "https://lrclib.net"
      ]
    }
  ],
  "supported_languages": [
    "en"
  ]
}
